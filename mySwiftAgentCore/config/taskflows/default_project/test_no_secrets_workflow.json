{
  "id": "test_no_secrets_workflow",
  "name": "test_no_secrets_workflow",
  "version": "1.0.0",
  "description": "TC-003, TC-007: Secretsを必要としないワークフロー（後方互換性テスト）",
  "inputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "string",
        "description": "入力データ"
      }
    },
    "required": ["data"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "string",
        "description": "変換結果"
      }
    }
  },
  "steps": [
    {
      "id": "transform",
      "name": "Transform Data",
      "type": "transform",
      "config": {
        "expression": "input.data.toUpperCase()"
      },
      "params": {
        "input": "$input"
      }
    }
  ],
  "outputMapping": {
    "result": "$steps.transform.result"
  }
}
