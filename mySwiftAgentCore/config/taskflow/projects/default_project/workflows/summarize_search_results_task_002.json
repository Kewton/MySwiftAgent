{
  "workflow_name": "summarize_search_results_task_002",
  "description": "Summarize search results using LLM to create a concise email-suitable summary",
  "input_schema": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array"
      }
    },
    "required": [
      "results"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "summary": {
        "type": "string"
      }
    }
  },
  "steps": [
    {
      "id": "format_results",
      "type": "transform",
      "config": {
        "mapping": {
          "formatted_results": "$.input.results"
        }
      },
      "params": {}
    },
    {
      "id": "generate_summary",
      "type": "llm",
      "config": {
        "prompt": "以下の検索結果を日本語で簡潔にまとめてください。メール本文として使用できる形式でお願いします。\n\n検索結果:\n{{steps.format_results.formatted_results}}",
        "model": "gpt-4o-mini",
        "temperature": 0.7,
        "max_tokens": 1000,
        "system_prompt": "あなたは検索結果をメール用に簡潔にまとめるアシスタントです。重要な情報を漏れなく、分かりやすくまとめてください。"
      },
      "params": {}
    }
  ],
  "output": {
    "summary": "$steps.generate_summary.content"
  }
}
