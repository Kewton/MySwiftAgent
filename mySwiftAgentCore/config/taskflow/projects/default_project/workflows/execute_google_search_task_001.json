{
  "workflow_name": "execute_google_search_task_001",
  "description": "Perform a Web search using the provided search query to gather relevant information",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array"
      }
    }
  },
  "steps": [
    {
      "id": "search_google",
      "type": "api_rest",
      "description": "Perform Google search with the provided query",
      "config": {
        "capability_id": "google_search",
        "method": "POST"
      },
      "params": {
        "body": {
          "queries": [
            "$input.query"
          ],
          "num": 3
        }
      }
    }
  ],
  "output": {
    "results": "$steps.search_google.search_results"
  }
}