{
  "workflow_name": "test_json_stringify",
  "description": "Test workflow to verify capability execution",
  "input_schema": {
    "type": "object",
    "properties": {
      "test_data": {
        "type": "string"
      }
    },
    "required": [
      "test_data"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "string"
      }
    }
  },
  "steps": [
    {
      "id": "stringify",
      "type": "api_rest",
      "config": {
        "capability_id": "json_stringify",
        "method": "POST"
      },
      "params": {
        "body": {
          "data": {
            "message": "$input.test_data"
          }
        }
      }
    }
  ],
  "output": {
    "result": "$steps.stringify.json_string"
  }
}
