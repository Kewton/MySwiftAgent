{
  "workflow_name": "execute_google_search_task_001",
  "description": "Perform a web search using Google to gather relevant information",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array"
      }
    }
  },
  "steps": [
    {
      "id": "perform_google_search",
      "type": "api_rest",
      "description": "Execute Google search with the provided query",
      "config": {
        "method": "POST",
        "url": "/capabilities/google_search/execute",
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "params": {
        "body": {
          "query": "$input.query"
        }
      }
    }
  ],
  "output": {
    "results": "$steps.perform_google_search.results"
  }
}