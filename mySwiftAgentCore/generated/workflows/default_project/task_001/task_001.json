{
  "workflow_name": "task_001",
  "description": "Workflow for task task_001",
  "input_schema": {
    "keyword_prompt": "string"
  },
  "output_schema": {
    "keyword": "string"
  },
  "steps": [
    {
      "id": "extract_keyword",
      "type": "api_rest",
      "description": "Extract keyword from prompt using JSON output agent",
      "config": {
        "method": "POST",
        "url": "http://localhost:8004/v1/aiagent/utility/jsonoutput",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "user_input": "${inputs.keyword_prompt}",
          "system_prompt": "Extract the main keyword from the given prompt. Return only a JSON object with a single 'keyword' field containing the extracted keyword as a string.",
          "model": "gemini-2.5-flash"
        },
        "timeout_ms": 30000
      },
      "params": {}
    }
  ],
  "output": {
    "keyword": "${extract_keyword.keyword}"
  }
}