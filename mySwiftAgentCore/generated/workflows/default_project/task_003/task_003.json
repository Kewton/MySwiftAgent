{
  "workflow_name": "task_003",
  "description": "Workflow for task task_003",
  "input_schema": {
    "keyword": "string"
  },
  "output_schema": {
    "search_results": "array"
  },
  "steps": [
    {
      "id": "google_search_step",
      "type": "api_rest",
      "config": {
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/google_search",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "queries": [
            "${inputs.keyword}"
          ],
          "num": 3
        },
        "timeout_ms": 30000
      },
      "params": {}
    }
  ],
  "output": {
    "search_results": "${google_search_step.search_results}"
  }
}