{
  "workflow_name": "test_directory_structure_test_dir_structure_1768639390",
  "description": "Test workflow for verifying nested directory structure for workflow storage",
  "input_schema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "string"
      }
    },
    "required": [
      "data"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "string"
      }
    }
  },
  "steps": [
    {
      "id": "process_data",
      "type": "transform",
      "description": "Process input data and create result",
      "config": {
        "expression": "({ result: `Processed: ${data}` })"
      },
      "params": {
        "data": "$input.data"
      }
    }
  ],
  "output": {
    "result": "$steps.process_data.result"
  }
}