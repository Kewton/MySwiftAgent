{
  "name": "myswiftagentcore",
  "version": "0.1.0",
  "type": "module",
  "description": "Core TypeScript services for MySwiftAgent - TaskFlow Engine, Capability Management, and TaskFlow Generator Agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "generate:catalog": "npx tsx scripts/generate-catalog.ts"
  },
  "keywords": [
    "taskflow",
    "workflow",
    "ai",
    "agent",
    "typescript"
  ],
  "author": "MySwiftAgent Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.1",
    "langfuse": "^3.0.0",
    "langfuse-node": "^3.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/ajv": "^0.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "msw": "^2.12.7",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
