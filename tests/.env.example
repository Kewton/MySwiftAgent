# =============================================================================
# MySwiftAgent Acceptance Test Environment Variables
# =============================================================================
#
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit actual API keys to version control!
#
# Usage:
#   cp tests/.env.example tests/.env
#   # Edit tests/.env with your values
#

# =============================================================================
# API Keys (Required for acceptance tests with LLM)
# =============================================================================

# Google Gemini API Key (used for most LLM-based tests)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (optional, for OpenAI provider tests)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional, for Claude provider tests)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Service URLs (Local defaults)
# =============================================================================

# Platform Layer Services
MYVAULT_URL=http://localhost:8003
JOBQUEUE_URL=http://localhost:8002
MYSCHEDULER_URL=http://localhost:8004

# Agent Layer Services
EXPERTAGENT_URL=http://localhost:8001
GRAPHAISERVER_URL=http://localhost:8005

# Frontend Layer Services
MYAGENTDESK_URL=http://localhost:5173

# =============================================================================
# Test Configuration
# =============================================================================

# Test timeout in seconds (default: 30)
TEST_TIMEOUT=30

# Number of retries for flaky tests (default: 3)
TEST_RETRY_COUNT=3

# Enable verbose logging during tests
TEST_VERBOSE=false

# =============================================================================
# CI-specific Variables (set automatically in CI)
# =============================================================================

# CI environment indicator
# CI=true

# Test-specific API key (used in CI to avoid exposing production keys)
# TEST_GOOGLE_API_KEY=your_ci_specific_key_here

# =============================================================================
# Notes:
# =============================================================================
#
# 1. Acceptance tests are NOT run in CI by default
# 2. Run acceptance tests locally before merging PRs
# 3. Use 'make acceptance-test-{layer}' to run tests
# 4. Services must be running before running tests
#    - Platform: make dev-platform
#    - Agent: make dev-agent
#    - All: make dev-all
#
