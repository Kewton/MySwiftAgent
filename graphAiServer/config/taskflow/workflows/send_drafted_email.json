{
  "workflow_name": "send_drafted_email",
  "description": "Interface for sending the drafted email via Gmail.",
  "input_schema": {
    "recipient_email": "string",
    "subject": "string",
    "body": "string"
  },
  "output_schema": {
    "success": "boolean",
    "message_id": "string",
    "timestamp": "string"
  },
  "steps": [
    {
      "id": "send_email",
      "type": "api_rest",
      "config": {
        "step_type": "api_rest",
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.recipient_email}",
          "subject": "${inputs.subject}",
          "body": "${inputs.body}"
        },
        "timeout_ms": 30000,
        "verify_ssl": true
      }
    }
  ],
  "output": {
    "success": "${send_email.output.success}",
    "message_id": "${send_email.output.message_id}",
    "timestamp": "${send_email.output.timestamp}"
  }
}