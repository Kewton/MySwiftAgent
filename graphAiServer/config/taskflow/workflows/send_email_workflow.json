{
  "workflow_name": "send_email_workflow",
  "description": "Sends an email via Gmail API",
  "input_schema": {
    "recipient_email": "string",
    "subject": "string",
    "email_body": "string"
  },
  "output_schema": {
    "message_id": "string",
    "status": "string"
  },
  "steps": [
    {
      "id": "send_email",
      "type": "api_rest",
      "config": {
        "step_type": "api_rest",
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.recipient_email}",
          "subject": "${inputs.subject}",
          "body": "${inputs.email_body}"
        },
        "timeout_ms": 30000,
        "verify_ssl": false
      },
      "params": {
        "recipient_email": "${inputs.recipient_email}",
        "subject": "${inputs.subject}",
        "email_body": "${inputs.email_body}"
      }
    },
    {
      "id": "format_output",
      "type": "transform",
      "config": {
        "step_type": "transform",
        "mode": "template",
        "template": "{\"to\": \"${inputs.recipient_email}\", \"subject\": \"${inputs.subject}\", \"body\": \"${inputs.email_body}\"}",
        "separator": ", ",
        "fields": [
          "to",
          "subject",
          "body"
        ]
      },
      "params": {
        "recipient_email": "${inputs.recipient_email}",
        "subject": "${inputs.subject}",
        "email_body": "${inputs.email_body}"
      }
    }
  ],
  "output": {
    "message_id": "${send_email.output.message_id}",
    "status": "${send_email.output.status}"
  }
}