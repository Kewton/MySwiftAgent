{
  "workflow_name": "send_email_workflow",
  "description": "Send an email to the specified recipient",
  "input_schema": {
    "to_email": "string",
    "subject": "string",
    "body": "string"
  },
  "output_schema": {
    "success": "boolean",
    "message_id": "string"
  },
  "steps": [
    {
      "id": "send_email",
      "type": "api_rest",
      "config": {
        "step_type": "api_rest",
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.to_email}",
          "subject": "${inputs.subject}",
          "body": "${inputs.body}"
        },
        "timeout_ms": 30000,
        "verify_ssl": false
      },
      "params": {}
    },
    {
      "id": "format_output",
      "type": "transform",
      "config": {
        "step_type": "transform",
        "mode": "template",
        "template": "{\"to\": \"${inputs.to_email}\", \"subject\": \"${inputs.subject}\", \"body\": \"${inputs.body}\"}",
        "separator": ", ",
        "fields": [
          "to",
          "subject",
          "body"
        ]
      },
      "params": {}
    }
  ],
  "output": {
    "success": "${send_email.output.success}",
    "message_id": "${send_email.output.message_id}"
  }
}