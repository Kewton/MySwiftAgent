{
  "workflow_name": "hello_world_llm_generator",
  "description": "A workflow that interfaces with an LLM via REST API to generate a 'Hello World' greeting based on a provided prompt.",
  "input_schema": {
    "prompt": "string"
  },
  "output_schema": {
    "greeting_text": "string"
  },
  "steps": [
    {
      "id": "llm_api_call",
      "type": "api_rest",
      "config": {
        "timeout_ms": 30000,
        "method": "POST",
        "body": {
          "model": "gpt-3.5-turbo",
          "temperature": 0.7,
          "messages": [
            {
              "content": "${inputs.prompt}",
              "role": "user"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${secrets.LLM_API_KEY}"
        },
        "url": "https://api.openai.com/v1/chat/completions"
      },
      "params": {}
    },
    {
      "id": "parse_llm_response",
      "type": "transform",
      "config": {
        "template": "${llm_api_call.data.choices[0].message.content}",
        "mode": "template"
      },
      "params": {}
    }
  ],
  "output": {
    "greeting_text": "${parse_llm_response}"
  }
}