{
  "workflow_name": "send_weather_email_workflow",
  "description": "Sends a formatted weather email via Gmail to a specific recipient.",
  "input_schema": {
    "recipient_email": "string",
    "subject": "string",
    "body": "string"
  },
  "output_schema": {
    "status": "string",
    "message_id": "string"
  },
  "steps": [
    {
      "id": "send_email",
      "type": "api_rest",
      "config": {
        "step_type": "api_rest",
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.recipient_email}",
          "subject": "${inputs.subject}",
          "body": "${inputs.body}"
        },
        "timeout_ms": 30000,
        "verify_ssl": true
      },
      "params": {}
    }
  ],
  "output": {
    "status": "${send_email.output.status}",
    "message_id": "${send_email.output.message_id}"
  }
}