{
  "workflow_name": "send_summarized_email",
  "description": "Sends a summarized text report to a specified email address using the internal Gmail API.",
  "input_schema": {
    "to": "string",
    "subject": "string",
    "body": "string"
  },
  "output_schema": {
    "message_id": "string",
    "status": "string"
  },
  "steps": [
    {
      "id": "send_gmail_api",
      "type": "api_rest",
      "config": {
        "method": "POST",
        "url": "https://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.to}",
          "subject": "${inputs.subject}",
          "body": "${inputs.body}"
        },
        "timeout_ms": 30000
      },
      "params": {}
    }
  ],
  "output": {
    "message_id": "${send_gmail_api.data.message_id}",
    "status": "${send_gmail_api.data.result}"
  }
}