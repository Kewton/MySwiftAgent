{
  "workflow_name": "google_search_ai_summary",
  "description": "Google検索を実行し、AIによる検索結果の要約とソースURLのリストを取得します。",
  "input_schema": {
    "query": "string"
  },
  "output_schema": {
    "overview": "string",
    "source_urls": "array"
  },
  "steps": [
    {
      "id": "perform_search",
      "type": "api_rest",
      "config": {
        "method": "POST",
        "url": "https://localhost:8004/v1/utility/google_search",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "queries": [
            "${inputs.query}"
          ],
          "num": 10
        },
        "timeout_ms": 30000
      },
      "params": {}
    },
    {
      "id": "generate_summary",
      "type": "api_rest",
      "config": {
        "method": "POST",
        "url": "https://localhost:8004/v1/mylllm",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "user_input": "以下の検索結果を基に、ユーザーのクエリ「${inputs.query}」に対する要約を作成してください。\n\n検索結果:\n${perform_search.data.search_results}",
          "system_prompt": "あなたは優秀なリサーチアシスタントです。提供された検索結果の断片（スニペット）を統合し、客観的で分かりやすい要約を作成してください。",
          "model": "gpt-4o-mini"
        }
      },
      "params": {}
    },
    {
      "id": "extract_links",
      "type": "api_rest",
      "config": {
        "method": "POST",
        "url": "https://localhost:8004/v1/aiagent/utility/jsonoutput",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "user_input": "${perform_search.data.search_results}",
          "system_prompt": "提供された検索結果リストから各項目の 'link' フィールドのみを抽出し、'urls' というキーを持つJSON配列として返してください。例: {\"urls\": [\"https://example.com\", ...]}"
        }
      },
      "params": {}
    }
  ],
  "output": {
    "overview": "${generate_summary.data.result}",
    "source_urls": "${extract_links.data.result.urls}"
  }
}