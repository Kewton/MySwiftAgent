{
  "workflow_name": "send_summarized_email_workflow",
  "description": "指定された宛先に、要約された情報をメールで送信します。",
  "input_schema": {
    "to": "string",
    "subject": "string",
    "body": "string"
  },
  "output_schema": {
    "status": "string",
    "message_id": "string"
  },
  "steps": [
    {
      "id": "send_gmail",
      "type": "api_rest",
      "config": {
        "step_type": "api_rest",
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.to}",
          "subject": "${inputs.subject}",
          "body": "${inputs.body}"
        },
        "timeout_ms": 30000,
        "verify_ssl": true
      },
      "params": {}
    }
  ],
  "output": {
    "status": "success",
    "message_id": "${send_gmail.output.message_id}"
  }
}