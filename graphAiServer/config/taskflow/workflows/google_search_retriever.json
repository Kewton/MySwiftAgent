{
  "workflow_name": "google_search_retriever",
  "description": "指定されたクエリでGoogle検索を実行し、ウェブサイトのタイトル、URL、スニペットを取得します。",
  "input_schema": {
    "search_query": "string"
  },
  "output_schema": {
    "search_results": "array"
  },
  "steps": [
    {
      "id": "google_search_api",
      "type": "api_rest",
      "config": {
        "method": "GET",
        "url": "https://www.googleapis.com/customsearch/v1?q=${inputs.search_query}&key=${secrets.GOOGLE_API_KEY}&cx=${secrets.GOOGLE_SEARCH_ENGINE_ID}",
        "timeout_ms": 20000
      },
      "params": {}
    },
    {
      "id": "extract_search_items",
      "type": "transform",
      "config": {
        "mode": "template",
        "template": "${google_search_api.data.items}"
      },
      "params": {}
    }
  ],
  "output": {
    "search_results": "${extract_search_items}"
  }
}