{
  "workflow_name": "send_summary_email",
  "description": "要約された情報を指定されたメールアドレスに送信します。",
  "input_schema": {
    "to_address": "string",
    "subject": "string",
    "body": "string"
  },
  "output_schema": {
    "success": "boolean",
    "message_id": "string"
  },
  "steps": [
    {
      "id": "send_email",
      "type": "api_rest",
      "config": {
        "step_type": "api_rest",
        "method": "POST",
        "url": "http://localhost:8004/v1/utility/gmail/send",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "to": "${inputs.to_address}",
          "subject": "${inputs.subject}",
          "body": "${inputs.body}"
        },
        "timeout_ms": 30000,
        "verify_ssl": false
      },
      "params": {}
    }
  ],
  "output": {
    "success": "${send_email.output.success}",
    "message_id": "${send_email.output.message_id}"
  }
}