  "technical_implementation": {
    "docker_compose": {
      "service_name": "valkey",
      "image": "valkey/valkey:latest",
      "container_name": "myswiftagent-valkey",
      "port": "6379:6379",
      "volumes": [
        "./valkey/data:/data",
        "./valkey/config/valkey.conf:/usr/local/etc/valkey/valkey.conf:ro"
      ],
      "healthcheck": "valkey-cli PING",
      "restart_policy": "unless-stopped"
    },
    "dev_start_script": {
      "port_variable": "VALKEY_PORT (default: 6379)",
      "startup_method": "Docker container",
      "health_check": "docker exec myswiftagent-valkey valkey-cli PING",
      "log_file": "$LOG_DIR/valkey.log",
      "pid_file": "$PID_DIR/valkey.pid",
      "service_url": "redis://localhost:6379"
    },
    "worktree_script": {
      "port_range": "6380-6399",
      "port_registry": ".valkey-ports",
      "port_allocation": "automatic with conflict detection",
      "data_isolation": "per-worktree valkey/data directory",
      "config_generation": "dynamic port substitution",
      "env_update": "VALKEY_URL in expertAgent/.env"
    }
  },
