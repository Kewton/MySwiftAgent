{
  "issue_number": 408,
  "feature_summary": "ユーザー入力フィールド名の整合性検証機能",
  "acceptance_criteria": [
    "AC-1: Interface Definitionプロンプトにユーザー入力フィールド名保持ルールが追加されている",
