# Langfuse v3 Environment Variables
# 更新日: 2025-11-03
# v2からv3へのアップグレードに伴い、新規環境変数を追加

# PostgreSQL Database Configuration
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse_secure_password_change_in_production
LANGFUSE_DB_NAME=langfuse

# Langfuse Core Configuration
NEXTAUTH_URL=http://localhost:3001
LANGFUSE_NEXTAUTH_SECRET=ODEZVOfVwd7TSBdsC8K3tf9X4CMS98T9TmScj/ZlzZA=
